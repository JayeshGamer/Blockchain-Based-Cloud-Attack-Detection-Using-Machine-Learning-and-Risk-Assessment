# Environment Configuration Template for Adaptive ML-DST V6
# Copy this file to .env to override default parameters

# Deterministic random seed
RANDOM_SEED=42

# Dataset mode: 'stratified', 'lightweight', or 'full'
DATASET_MODE=stratified

# Streaming batch size (number of network flows per prequential step)
STREAM_BATCH_SIZE=1000

# Label delay in batches (D=1 means delayed feedback by 1 batch / 1,000 flows)
LABEL_DELAY_BATCHES=1

# Optional Blockchain RPC endpoint (leave empty for local mock ledger fallback)
# BLOCKCHAIN_RPC_URL=http://localhost:8545
# CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
