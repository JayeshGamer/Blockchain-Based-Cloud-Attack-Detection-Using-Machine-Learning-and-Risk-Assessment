{
  "preprocessor": {
    "class": "NetworkDataPreprocessor",
    "effective_params": {
      "scaler": "robust",
      "imputer_strategy": "training_median",
      "drop_constant_columns": true,
      "drop_duplicate_fwd_header": true,
      "outlier_clip": [
        -50.0,
        50.0
      ]
    }
  },
  "online_models": {
    "linear_class": "OnlineSGDClassifier",
    "linear_effective_params": {
      "algorithm": "sgd_classifier",
      "loss": "log_loss",
      "penalty": "l2",
      "alpha": 0.0001,
      "learning_rate": "optimal"
    },
    "nonlinear_class": "RiverHoeffdingAdaptiveTreeOnline",
    "nonlinear_effective_params": {
      "algorithm": "river_hoeffding_adaptive_tree",
      "grace_period": 100,
      "split_criterion": "info_gain",
      "split_confidence": 1e-05
    }
  },
  "anomaly_detector": {
    "class": "AnomalyEvidenceDetector",
    "effective_params": {
      "algorithm": "isolation_forest",
      "n_estimators": 50,
      "contamination": 0.05,
      "max_samples": 5000,
      "train_on_benign_only": true,
      "percentile_min": 2.0,
      "percentile_max": 98.0
    }
  },
  "drift_detector": {
    "class": "ADWIN / RiverADWIN",
    "effective_params": {
      "algorithm": "adwin",
      "delta": 0.002,
      "clock": 32,
      "min_window_length": 10,
      "grace_period": 100,
      "monitored_signals": [
        "delayed_loss",
        "attack_score",
        "packet_rate"
      ]
    }
  },
  "drift_coordinator": {
    "class": "MultiSignalDriftCoordinator",
    "effective_params": {
      "delta": 0.002,
      "strategy": "plasticity_boost",
      "boost_factor": 2.0,
      "cooldown_batches": 20
    }
  },
  "temporal_deviation": {
    "class": "TemporalDeviationTracker",
    "effective_params": {
      "window_size": 200,
      "protected_benign_baseline": true,
      "benign_confidence_threshold": 0.35,
      "metrics": {
        "flow_bytes_per_s": 0.25,
        "flow_packets_per_s": 0.25,
        "flow_duration": 0.15,
        "flow_iat_mean": 0.15,
        "pkt_ratio": 0.1,
        "attack_score_dev": 0.1
      }
    }
  },
  "dst_fusion": {
    "class": "DSTEvidenceFusion",
    "effective_params": {
      "frame_of_discernment": [
        "Benign",
        "Attack"
      ],
      "uncertainty_budget": 0.15,
      "reliability_discounting": "shafer",
      "tuning_status": "fixed_validation_tuned_hyperparameters",
      "tuning_grid": {
        "ml_attack_score": [
          0.7,
          0.75,
          0.8,
          0.85,
          0.9
        ],
        "anomaly_score": [
          0.6,
          0.65,
          0.7,
          0.75,
          0.8
        ],
        "temporal_deviation": [
          0.5,
          0.6,
          0.7,
          0.75,
          0.8
        ]
      },
      "source_reliabilities": {
        "ml_attack_score": 0.85,
        "anomaly_score": 0.75,
        "temporal_deviation": 0.7
      },
      "conflict_threshold": 0.9,
      "conflict_rule": "yager"
    }
  },
  "adaptive_threshold": {
    "class": "AdaptiveThresholdManager",
    "effective_params": {
      "mode": "recall_constrained",
      "min_target_recall": 0.9,
      "f_beta": 2.0,
      "initial_threshold": 0.5,
      "target_fpr": 0.02,
      "rolling_window_size": 500,
      "min_threshold": 0.15,
      "max_threshold": 0.85,
      "drift_relaxation_factor": 0.85,
      "smoothing_alpha": 0.05,
      "freeze_during_burst": true
    }
  }
}